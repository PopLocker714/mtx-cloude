# Скопируй в .env для локального запуска (в git не попадает).
# В Dokploy эти же переменные задаются в UI: приложение → Environment.

# Публичный IP или домен сервера (нужен WebRTC-просмотру в браузере)
SERVER_HOST=1.2.3.4

# База данных (Postgres в этом же compose)
POSTGRES_USER=oko
POSTGRES_PASSWORD=замени-на-длинный-пароль-БД
POSTGRES_DB=oko

# Better Auth
# Базовый URL API (домен бэкенда, когда навесим Traefik; пока — http://SERVER_HOST:9998 недоступен снаружи)
API_BASE_URL=http://localhost:9998
# Секрет для подписи сессий — обязательно длинный случайный (openssl rand -hex 32)
BETTER_AUTH_SECRET=замени-на-случайный-секрет-32-байта
# Разрешённые origin для ЛК (через запятую): домен фронта + локальная разработка
TRUSTED_ORIGINS=http://localhost:9998,http://localhost:5173
