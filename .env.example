# Скопируй в .env для локального запуска (в git не попадает).
# В Dokploy эти же переменные задаются в UI: приложение → Environment.

# ── Домены (wildcard *.tunnel.poploker.ru → A на сервер; SSL Dokploy выпускает сам) ──
#   api.tunnel.poploker.ru      → backend  : 9998   (API + Better Auth)
#   live.tunnel.poploker.ru     → mediamtx : 8889   (live WebRTC)
#   archive.tunnel.poploker.ru  → mediamtx : 9996   (архив, Playback API)
#   hls.tunnel.poploker.ru      → mediamtx : 8888   (live HLS, запасной)
#   app.tunnel.poploker.ru      → ЛК-фронт (позже)
#   ingest.tunnel.poploker.ru   → mediamtx : 8554   RTSP-ingest, БЕЗ SSL (не через Traefik)
#   ВАЖНО: UDP 8189 держать открытым напрямую (WebRTC ICE, Traefik его не проксирует).

# WebRTC сообщает браузеру этот host как адрес медиапотока → live-домен
SERVER_HOST=live.tunnel.poploker.ru

# База данных (Postgres в этом же compose)
POSTGRES_USER=oko
POSTGRES_PASSWORD=замени-на-длинный-пароль-БД
POSTGRES_DB=oko

# Better Auth
API_BASE_URL=https://api.tunnel.poploker.ru
BETTER_AUTH_SECRET=замени-на-случайный-секрет-32-байта
TRUSTED_ORIGINS=https://app.tunnel.poploker.ru,https://api.tunnel.poploker.ru
# (COOKIE_DOMAIN больше не нужен — кука host-only на api-домене, SameSite=None; Secure)

# Web (ЛК): адрес API. Необязателен — фронт сам выводит api.<домен> из app.<домен>.
VITE_API_URL=https://api.tunnel.poploker.ru

# RTSP-ingest хост, который показываем в мастере подключения камеры
INGEST_HOST=ingest.tunnel.poploker.ru:8554

# ── Шифрование ингеста bridge→облако (фикс H1) ────────────────────────────────
# По умолчанию ингест идёт ОТКРЫТЫМ RTSP (видео + publishToken по интернету в открытом виде).
# INGEST_SCHEME=rtsps переводит на RTSP-over-TLS. Полный деплой-гайд (2 пути терминации TLS,
# фазовый выкат без простоя, выдача сертификата, верификация) — docs/INGEST_TLS.md.
# Рекомендация для сетапа Cloudflare(DNS-only)+Dokploy: нативный RTSPS в MediaMTX + acme.sh
# DNS-01 через Cloudflare (self-contained, hot-reload серта подтверждён). Кратко:
#   1) Cloudflare API-токен (Zone:DNS:Edit + Zone:Read):
# CF_DNS_API_TOKEN=
#   2) добавь acme-сервис + RTSPS-env MediaMTX (готовый compose-фрагмент в docs/INGEST_TLS.md),
#   3) раскомментируй:
# INGEST_SCHEME=rtsps
# INGEST_HOST=ingest.tunnel.poploker.ru:8322
# На bridge-агентах OKO_INGEST_TLS_VERIFY=1 (дефолт, защита от MITM); при своём CA — OKO_INGEST_CA_FILE.

# Ключ шифрования RTSP-credentials камер (AES-256-GCM). openssl rand -hex 32.
# Fail-closed как BETTER_AUTH_SECRET: если есть камеры через bridge, а ключ не задан — backend упадёт.
# ВНИМАНИЕ: смена ключа делает уже сохранённые creds недешифруемыми — задать один раз.
BRIDGE_SECRET_KEY=

# Админ. При старте: если юзер с этим email есть — станет админом; если нет и задан
# ADMIN_PASSWORD (≥8) — создастся. Можно указать свой уже зарегистрированный email.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=длинный-пароль-если-создавать-нового

# ── Почта: Resend (подтверждение email, сброс пароля) ─────────────────────────
# Пока ключ пуст — письма НЕ уходят, код подтверждения печатается в лог бэкенда
# (docker compose logs -f backend). С ключом коды уходят письмом, и сброс пароля
# начинает работать в том числе в production.
# resend.com → API Keys. Домен отправителя нужно верифицировать (DNS), иначе
# письма уйдут только на адрес владельца аккаунта с onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=oko <onboarding@resend.dev>

# Демо-сброс пароля без настроенной почты (код читается из логов) — НЕБЕЗОПАСНО.
# Работает только вне production и только пока RESEND_API_KEY пуст. На боевом держать пустым.
STUB_AUTH=

# ── Соцвходы ──────────────────────────────────────────────────────────────────
# Кнопки Google / Apple / Telegram нарисованы всегда; активной становится та,
# для которой заданы ключи (бэкенд сообщает список через GET /api/auth-providers).
#
# Google: console.cloud.google.com → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://api.<домен>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com → Certificates, Identifiers & Profiles → Services ID + ключ Sign in with Apple.
# APPLE_CLIENT_SECRET — это JWT, подписанный ключом .p8 (живёт до 6 месяцев).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Telegram: это не OAuth, а Login Widget — нужен bot token от @BotFather,
# домен бота задаётся командой /setdomain. Кнопка останется неактивной, пока пусто.
# Тот же бот шлёт уведомления о движении (webhook: https://api.<домен>/api/telegram/webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
