# Скопируй в .env для локального запуска (в git не попадает).
# В Dokploy эти же переменные задаются в UI: приложение → Environment.

# Публичный IP или домен сервера (нужен WebRTC-просмотру в браузере)
SERVER_HOST=1.2.3.4

# Учётка для ПУБЛИКАЦИИ потоков (бридж/ffmpeg/камера) — только publish
PUBLISH_USER=publisher
PUBLISH_PASS=замени-на-длинный-пароль-1

# Учётка для ПРОСМОТРА live и архива — только read/playback
VIEW_USER=viewer
VIEW_PASS=замени-на-длинный-пароль-2
