# Скопируй в .env для локального запуска (в git не попадает).
# В Dokploy эти же переменные задаются в UI: приложение → Environment.

# ── Домены (wildcard *.tunnel.poploker.ru → A на сервер; SSL Dokploy выпускает сам) ──
#   api.tunnel.poploker.ru      → backend  : 9998   (API + Better Auth)
#   live.tunnel.poploker.ru     → mediamtx : 8889   (live WebRTC)
#   archive.tunnel.poploker.ru  → mediamtx : 9996   (архив, Playback API)
#   hls.tunnel.poploker.ru      → mediamtx : 8888   (live HLS, запасной)
#   app.tunnel.poploker.ru      → ЛК-фронт (позже)
#   ingest.tunnel.poploker.ru   → mediamtx : 8554   RTSP-ingest, БЕЗ SSL (не через Traefik)
#   ВАЖНО: UDP 8189 держать открытым напрямую (WebRTC ICE, Traefik его не проксирует).

# WebRTC сообщает браузеру этот host как адрес медиапотока → live-домен
SERVER_HOST=live.tunnel.poploker.ru

# База данных (Postgres в этом же compose)
POSTGRES_USER=oko
POSTGRES_PASSWORD=замени-на-длинный-пароль-БД
POSTGRES_DB=oko

# Better Auth
API_BASE_URL=https://api.tunnel.poploker.ru
BETTER_AUTH_SECRET=замени-на-случайный-секрет-32-байта
TRUSTED_ORIGINS=https://app.tunnel.poploker.ru,https://api.tunnel.poploker.ru
# Общий домен для кросс-сабдоменной сессионной куки (app. ↔ api.)
COOKIE_DOMAIN=.tunnel.poploker.ru
